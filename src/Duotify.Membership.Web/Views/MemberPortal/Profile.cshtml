@model ProfileViewModel
@{
    ViewData["Title"] = "會員資料";
}

<section class="space-y-6">
    @if (!string.IsNullOrWhiteSpace(Model.RestrictionMessage))
    {
        <partial name="_VerificationRestrictionBanner" model="(Model.RestrictionMessage!, Model.RegistrationReference)" />
    }

    @if (!string.IsNullOrWhiteSpace(Model.ActionMessage))
    {
        <div class="rounded-[8px] border border-hairline-light bg-canvas-light px-4 py-3 text-sm text-shade-70">@Model.ActionMessage</div>
    }

    <div class="grid gap-6 lg:grid-cols-[1.6fr_1fr]">
        <div class="rounded-[12px] border border-hairline-light bg-canvas-light p-8 shadow-paper">
            <div class="mb-6 space-y-2">
                <span class="inline-flex rounded-pill bg-pistachio px-4 py-2 text-xs font-semibold uppercase tracking-[0.72px] text-ink">Profile</span>
                <h1 class="text-4xl font-light tracking-[0.4px] text-ink">基本資料</h1>
            </div>
            <dl class="grid gap-5 md:grid-cols-2">
                <div>
                    <dt class="text-sm font-semibold text-shade-50">姓名</dt>
                    <dd class="mt-2 text-lg text-ink">@Model.FullName</dd>
                </div>
                <div>
                    <dt class="text-sm font-semibold text-shade-50">E-Mail</dt>
                    <dd class="mt-2 text-lg text-ink">@Model.Email</dd>
                </div>
                <div>
                    <dt class="text-sm font-semibold text-shade-50">身分證字號</dt>
                    <dd class="mt-2 text-lg text-ink">@Model.NationalIdMasked</dd>
                </div>
                <div>
                    <dt class="text-sm font-semibold text-shade-50">帳號狀態</dt>
                    <dd class="mt-2 text-lg @(Model.IsVerified ? "text-emerald-700" : "text-amber-700")">@(Model.IsVerified ? "已驗證" : "未驗證")</dd>
                </div>
            </dl>
        </div>

        <div class="rounded-[12px] border border-hairline-light bg-canvas-light p-8 shadow-paper">
            <div class="space-y-2">
                <h2 class="text-2xl font-medium tracking-[0.3px] text-ink">互動功能</h2>
                <p class="text-sm leading-6 text-shade-60">這個示範按鈕代表需要完整啟用權限的互動操作。</p>
            </div>

            <form asp-action="DemoAction" method="post" class="mt-6 space-y-4">
                @Html.AntiForgeryToken()
                <button type="submit" class="inline-flex w-full items-center justify-center rounded-pill px-5 py-3 text-sm font-semibold transition @(Model.CanPerformInteractiveAction ? "bg-ink text-white hover:bg-shade-70" : "cursor-not-allowed border border-hairline-light bg-shade-30 text-shade-50")" @(Model.CanPerformInteractiveAction ? null : "disabled")>
                    執行互動操作
                </button>
                @if (!Model.CanPerformInteractiveAction)
                {
                    <p class="text-sm text-shade-60">完成 E-Mail 驗證後，才可使用此功能。</p>
                }
            </form>
        </div>
    </div>
</section>