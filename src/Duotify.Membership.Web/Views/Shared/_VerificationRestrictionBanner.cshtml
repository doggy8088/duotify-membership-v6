@model (string Message, string RegistrationReference)

<div class="rounded-[12px] border border-amber-200 bg-amber-50 px-5 py-4 text-sm text-amber-800">
    <div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
        <div>
            <p class="font-semibold">帳號尚未完成 E-Mail 驗證</p>
            <p>@Model.Message</p>
        </div>
        <a asp-controller="Registration" asp-action="Verify" asp-route-registrationRef="@Model.RegistrationReference" class="inline-flex rounded-pill border border-amber-800 px-4 py-2 font-semibold transition hover:bg-amber-800 hover:text-white">前往驗證</a>
    </div>
</div>